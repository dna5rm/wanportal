# Ignore everything by default
**

# Exceptions (keep these)
!api-docs/
!cgi-bin/
!htdocs/
!agent/
!notify/

# Re-exclude build artifacts inside the kept dirs: the packaged agent image
# (netping_latest.tar.gz, ~21 MB) is a build output served by the dashboard,
# not source - it must not bloat the Docker build context.
htdocs/assets/*.tar.gz
