# addons-proxy.conf.example
#
# Copy next to docker-compose.yml, then edit:
#   cp conf/addons-proxy.conf.example conf/addons-proxy.conf
#
# The image IncludeOptional's /srv/conf/addons-proxy.conf (the repo is
# bind-mounted at /srv). conf/addons-proxy.conf is gitignored. This
# example is the tracked template. Routing only; no secrets.
#
# The addon is a compose sidecar on the same network. Apache uses the
# service name as the hostname. Do not ProxyPass /, /cgi-bin, /classic,
# /api-docs, or /assets.

ProxyPreserveHost On

# Example: wanportal-addon-nb (NetBox certs, sites, cloud-api).
# Everything under /nb/ including /nb/cloud-api/ rides this one prefix.
# Scope the header so it does not leak onto later prefixes.
<Location /nb/>
    RequestHeader set X-Forwarded-Prefix "/nb"
</Location>
ProxyPass        /nb/ http://wanportal-addon-nb:80/nb/
ProxyPassReverse /nb/ http://wanportal-addon-nb:80/nb/

# Example: a second sidecar on its own prefix (wanportal-addon-ipc).
# Uncomment to enable; each addon keeps one stable prefix and its own
# X-Forwarded-Prefix value.
# <Location /ipc/>
#     RequestHeader set X-Forwarded-Prefix "/ipc"
# </Location>
# ProxyPass        /ipc/ http://wanportal-addon-ipc:80/ipc/
# ProxyPassReverse /ipc/ http://wanportal-addon-ipc:80/ipc/

# Example: a third sidecar on its own prefix (wanportal-addon-catalog).
# Uncomment to enable; each addon keeps one stable prefix and its own
# X-Forwarded-Prefix value.
# <Location /catalog/>
#     RequestHeader set X-Forwarded-Prefix "/catalog"
# </Location>
# ProxyPass        /catalog/ http://wanportal-addon-catalog:80/catalog/
# ProxyPassReverse /catalog/ http://wanportal-addon-catalog:80/catalog/

# Optional extra host-only rules:
# IncludeOptional /srv/conf/addons-site.conf
