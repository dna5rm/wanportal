# netping agent image: Alpine + cronie + Perl, runs the probe agent from cron.
# Built by ./build_agent.sh -> tags netping:<date> and netping:latest, then
# packaged to htdocs/assets/netping_latest.tar.gz. See api-docs/agent-image.md.
#
# The image ships only netping-agent.pl and its cron wrapper run-agent.sh.
# netping-legacy.pl and socket-agent.pl are intentionally not packaged;
# run those from a checkout instead.
FROM alpine:3.21.3

# Create and set working directory
WORKDIR /srv

# Copy the shipped agent script and its cron wrapper; nothing else from the
# repo goes into the image.
COPY netping-agent.pl /srv/
COPY run-agent.sh /srv/

# Runtime packages, installed in one layer with --no-cache (no apk upgrade:
# the pinned base image is already current; a blanket upgrade would just
# bloat the layer):
#   cronie  - crond, the container's main process; runs the agent every minute
#   tzdata  - sane timestamps in logs
#   perl    - Net::Ping, Time::HiRes, POSIX and List::Util ship with core perl
#   perl-libwww             - LWP::UserAgent, the API client
#   perl-lwp-protocol-https - HTTPS support for LWP
#   perl-io-socket-ssl      - SSL backend; netping-agent.pl sets
#                             SSL_VERIFY_NONE on purpose (self-signed certs
#                             are allowed), so keep that behavior as-is
#   perl-json               - JSON request/response payloads
# curl/jq, perl-sys-cpu, perl-lwp-useragent-determined and
# perl-parallel-forkmanager are not shipped: netping-agent.pl does not use
# them (sys-cpu/parallel-forkmanager belong to socket-agent.pl, which is not
# part of this image).
RUN apk add --no-cache cronie tzdata \
    perl perl-libwww perl-lwp-protocol-https perl-io-socket-ssl perl-json

# Cron schedule: one probe cycle per minute. Job output is redirected to
# /proc/1/fd/1 and fd/2 - PID 1 is the shell wrapping crond, and its
# stdout/stderr are the container's, so probe activity shows up in `docker
# logs`. run-agent.sh picks up SERVER/PASSWORD/AGENT_ID from /srv/.env when
# mounted, otherwise from /proc/1/environ - cron jobs do not inherit the
# container env.
RUN install -m 0644 /dev/stdin /etc/crontabs/root <<EOF
*/1 * * * * /srv/run-agent.sh > /proc/1/fd/1 2>/proc/1/fd/2
EOF

# Agent scripts must stay executable for cron
RUN chmod 755 /srv/*.pl /srv/*.sh

# Healthcheck: there is no HTTP endpoint in the container to poke (and curl
# is deliberately not shipped), so verify the container's actual job instead:
# crond is alive and the agent script is executable.
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD pidof crond >/dev/null && test -x /srv/netping-agent.pl

# Foreground crond; -s sends job output to syslog instead of trying to mail
# it (the crontab redirect above already sends it to the container's stdout).
CMD crond -f -s